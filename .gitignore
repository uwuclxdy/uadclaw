# Local docker-secrets material for compose (real .env is already globally ignored).
secrets/

# Local-only compose overlay. It publishes Postgres on loopback so host-side pytest and
# alembic can reach it. `deploy.sh` rsyncs git-tracked files only, so keeping this untracked
# is what stops the server from publishing a port it has no use for.
docker-compose.override.yml

# Operator-supplied pipeline inputs, bind-mounted read-only at /data. `uad_lists.json` is a
# 1.6 MB copy of somebody else's file that changes daily; the pipeline records the sha256 and
# mtime of whichever copy it read, so the copy itself is data rather than source.
data/

# hatchling / uv build output.
dist/
build/
*.egg-info/
