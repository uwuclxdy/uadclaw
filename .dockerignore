# Exclude from the build context so `COPY . .` doesn't ship the repo.

# VCS / IDE
.git
.gitignore
.idea
.vscode

# Local env, never bake into the image
.env
.env.*
!.env.example

# Real local credential material for compose file-secrets — never bake plaintext
# credentials into an image layer (recoverable via `docker history` / `docker save` even
# if a later layer deletes them).
secrets/

# Python tooling caches and the local venv (image rebuilds its own with uv)
.venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache

# Build / packaging artefacts
dist
build
*.egg-info

# Tests + dev-only docs aren't needed at runtime
tests

# Operator-supplied pipeline inputs. The worker bind-mounts these at /data at run time, so
# baking a copy into the image would only give it a stale one to read by accident.
data

# OS noise
.DS_Store
Thumbs.db
