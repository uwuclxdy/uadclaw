# Copy to .env for local (non-docker-secrets) runs. Never commit the real .env.
# In docker compose, these are mounted as files under /run/secrets instead (see
# docker-compose.yml); pydantic-settings reads secrets_dir first, env/.env as fallback.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=uadclaw
POSTGRES_PASSWORD=changeme
POSTGRES_DB=uadclaw
# Seconds one connection attempt may take. Bounds a routable-but-dead host, which asyncpg
# would otherwise wait 60 seconds on while every dashboard screen hangs.
POSTGRES_CONNECT_TIMEOUT_SECONDS=10

AUTH_PASSWORD=changeme
SESSION_SECRET=changeme-generate-a-random-value

# Plain-HTTP LAN-only deployment by default; flip to true only behind TLS.
COOKIE_SECURE=false

# Google's factory-image terms. The index at developers.google.com/android/images answers
# HTTP 200 with prose and ZERO download links until they are acknowledged, so the Pixel
# driver refuses to fetch until this is set. Setting it IS the acceptance — read the terms
# first. Unset by default on purpose: nothing should accept a licence on the operator's
# behalf.
# PIXEL_TERMS_ACK_COOKIE_VALUE=nexus-image-tos

# Comma-separated firmware drivers to refuse (e.g. samsung,oppo). Empty means all enabled.
# DISABLED_FIRMWARE_DRIVERS=

# Motorola codenames to enumerate, comma-separated. Required for the motorola driver: the
# lolinet mirror is a directory tree with no index document, so listing "everything" would be
# thousands of requests against a mirror that states its files are free but NOT for commercial
# use. Find a codename by browsing mirrors.lolinet.com/firmware/lenomola/<year>/.
# MOTOROLA_DEVICES=rtwo,bronco

# Extra Oppo/OnePlus/realme models the catalogue never carried, comma-separated, each
# `MODEL:REGION` naming the one of the four endpoint regions (GL, CN, IN, EU) that resolves it:
# RMX3301 resolves on EU and RMX3706 on GL (both measured 2026-08-12), and which region answers
# which model is per-model, so the region is part of the entry rather than walked. The driver
# asks the endpoint straight for each model at a synthesized `.00` build, walking the five
# branch letters the catalogue has ever published (A, F, C, H, J) and taking the first that
# answers; the endpoint answers the NEXT build in the chain, never the newest, so the ref the
# listing gains is that chain's answer, build id `{ota_version}_{REGION}`. A model that answers
# 2004 to every letter — the five modern export models do — is skipped with a warning naming
# it, and the catalogue refs still come back. Naming a model the catalogue already carries is
# a no-op with a log line, because the catalogue's newest build outranks the endpoint's on
# every model where both were measured.
# OPPO_MODELS=RMX3301:EU,RMX3706:GL

# Samsung models and CSC region codes, comma-separated. BOTH are required for the samsung
# driver: its index answers one model/CSC pair at a time and 403s for a pair that does not
# exist, so there is no catalogue to enumerate and the driver probes the grid named here.
# The two MULTIPLY into one request each, so widen one axis at a time.
# A model is sold under a handful of CSCs and the cross product names the rest, so most pairs
# legitimately 403; a model that resolves under none of its CSCs is logged as a warning.
# SAMSUNG_MODELS=SM-S911U,SM-S928B
# SAMSUNG_REGIONS=XAA,EUX

# Where the samsung index lives. The FUS endpoints that resolve and serve the binary are
# deliberately NOT settings: they are reverse-engineered, and repointing a host cannot repair
# a protocol change.
# SAMSUNG_INDEX_URL=https://fota-cloud-dn.ospserver.net/firmware

# The catalogue the oppo driver lists from. The INDEX only: it publishes one row per model and
# region with the newest build, its md5 and a durable download gate, and the four OPlus
# component-OTA endpoints that resolve a download are deliberately NOT settings, for the same
# reason Samsung's FUS hosts are not. It is a third-party site that escalates scraping to an
# IP-level block of its whole domain, so the driver reads it once per job and caches it; point
# this at a mirror if that ever bites.
# OPPO_CATALOGUE_URL=https://roms.danielspringer.at/api/ota.php?latest=1

# `payload-dumper-go` is vendored onto PATH in the worker image. On a dev box installed with
# `go install`, point this at it.
# PAYLOAD_DUMPER_PATH=/home/you/go/bin/payload-dumper-go

# The upstream uad_lists.json the filter stage reads to know which packages are already
# carried. Operator-supplied on purpose: it decides what the pipeline proposes, and the copy's
# sha256 and mtime are recorded on every row it decides. The filter refuses a missing or empty
# file rather than pushing the whole corpus into the queue. Default is /data/uad_lists.json,
# which the worker container bind-mounts read-only from ./data. Fetch or refresh it with:
#   mkdir -p data && curl -fsSL -o data/uad_lists.json https://raw.githubusercontent.com/Universal-Debloater-Alliance/universal-android-debloater-next-generation/main/resources/assets/uad_lists.json
# UPSTREAM_LIST_PATH=/data/uad_lists.json

# Branch emission: the operator's own clone of the upstream repo, which the worker commits a
# branch into and never pushes, fetches or authenticates against. Blank by default and NOT
# refused at startup — a branch_emission job refuses at the point of use and names this
# setting, because every other stage is useful on a box with no clone. Blank is deliberately
# distinct from ".": Path("") is the app root inside the worker image, and a git repo above it
# would read as a valid clone. docker-compose.yml bind-mounts the clone read-write at
# /upstream and owns the host-side path and the chown that mount needs; read its comment
# before pointing this anywhere.
# UPSTREAM_REPO_PATH=/upstream

# Where uad_lists.json lives inside that clone, and the ref to cut the emission branch from.
# A fork can name its default branch anything, which is why the base ref is a setting rather
# than assumed.
# UPSTREAM_REPO_LIST_PATH=resources/assets/uad_lists.json
# UPSTREAM_BASE_REF=main

# Prefix for the emitted branch, which is named {prefix}/{vendor}-{12 hex of the job id}. The
# job id is what makes a retry meet its own branch instead of cutting a second one.
# EMISSION_BRANCH_PREFIX=uadclaw

# The commit of THIS pipeline that produced a batch. Blank refuses the emission rather than
# opening a PR without it: upstream's CONTRIBUTING requires the disclosure, and the worker
# image carries no .git to derive it from, so it has to arrive from outside:
#   PIPELINE_COMMIT_SHA=$(git rev-parse HEAD) docker compose up -d
# PIPELINE_COMMIT_SHA=

# Optional public base URL for the evidence bundles, rendered as a link in the PR body. Left
# unset the body states the bundle hashes without linking them, which is the normal case for a
# LAN-only deployment.
# EMISSION_BUNDLE_BASE_URL=

# LLM providers: one entry per provider the LLM stages may call, as one JSON object. The
# provider table REPLACES the old DEEPSEEK_* settings (2026-08-24 provider generalization):
# there are no DEEPSEEK_* keys any more, and a classification job naming a provider that is
# not in this table is refused at CREATION. Each entry carries the OpenAI-format base url
# (never /anthropic — the cost measurement reads usage.prompt_cache_hit_tokens, which that
# wire format does not carry), the model id, the thinking flag (its reasoning tokens bill as
# output at ~20x the thinking-off spend; measured: default 110 completion tokens of which
# 104 reasoning, thinking disabled 5 and none), the output ceiling (covers reasoning AND the
# JSON body — too small returns finish_reason="length" with EMPTY content, which looks like
# the documented empty-content bug and has the opposite fix), and the in-flight ceiling
# (DeepSeek gates on concurrency alone, account-wide across every key, so stay far below its
# published ceiling). A job's params may name one of the ids via `provider`; jobs that name
# none use LLM_DEFAULT_PROVIDER. The deepseek entry below reproduces the old defaults
# verbatim, so migrating an existing deployment is renaming the key file plus this one
# variable. BOTH containers read this variable: docker compose interpolates it into the web
# and worker services from this same .env, and the web process needs the table to validate a
# job's provider at CREATION — a table that only the worker can see means every launch is a
# 422. A mounted secrets/llm_providers file also works and wins over the env (like every
# other file secret); it must then be mounted into BOTH services for the same reason. One
# caveat on the thinking flag: `false` sends the DeepSeek-specific
# `{"thinking": {"type": "disabled"}}` wire field, so settings load refuses it on every
# entry that is not deepseek, naming the entry — deepseek by id `deepseek` or by a
# base_url whose hostname is api.deepseek.com or ends in .deepseek.com. A gateway
# fronting deepseek is refused too and sets thinking true: fail-closed, the field is then
# simply not sent.
# LLM_PROVIDERS={"deepseek": {"base_url": "https://api.deepseek.com", "model": "deepseek-v4-flash", "thinking": true, "max_tokens": 16384, "max_concurrency": 4}}
# LLM_DEFAULT_PROVIDER=deepseek

# One key per provider, blank by default and NOT refused at startup, unlike the three
# credentials above: the whole deterministic pipeline (acquire through rule_ladder) is
# independently useful and has to boot on a box with no LLM account. A blank key fails at
# the first call instead, naming the file and the environment variable. In docker it is a
# file secret mounted only into the worker — nothing web serves calls the model — as
# secrets/llm_<id>_key -> /run/secrets/llm_<id>_key; a non-blank file wins over the env var
# and a blank one falls back to it. deepseek-v4-flash is the cheaper of the two live models
# and carries 5x the concurrency ceiling of deepseek-v4-pro; the legacy deepseek-chat /
# deepseek-reasoner ids were discontinued 2026-07-24 and no longer resolve.
# LLM_DEEPSEEK_KEY=sk-...

# Wire retries WITHIN one request — 3 is one attempt plus two on a 429/500/503 or a dropped
# connection. This bounds a single call, never a package; the per-package budget below is
# what bounds spend, and the two deliberately do not multiply. Global across providers: the
# retry layer is one.
# LLM_MAX_ATTEMPTS=3
# LLM_RETRY_BACKOFF_SECONDS=2.0
# LLM_REQUEST_TIMEOUT_SECONDS=300.0

# Hard ceiling on how many packages one classification job may call the API for. A job's own
# params may ask for fewer, never more, so a mis-typed job cannot bill a whole corpus.
# CLASSIFICATION_MAX_PACKAGES=500

# Billed requests ONE package may cost, counting every wire retry — the single knob that
# bounds per-package spend, and what `package_classification.attempts` records, so the row
# and the invoice agree. A package can fail on the wire (retried inside the client) or in its
# answer (re-prompted by the stage); one budget covers both, because a cap on each multiplies
# into a ceiling nobody intended. 3 keeps the common case — a model that is confidently wrong
# — at one request per re-prompt; a package hit by repeated 503s spends the budget on
# transport and gets fewer re-prompts, which is the right way round.
# CLASSIFICATION_MAX_CALLS_PER_PACKAGE=3

# The Brave Search API key the corroboration stage calls with. Same posture as the provider
# keys: blank by default, not refused at startup, refused at the point of use — a
# classification job ENDS at corroborate, so finishing one needs a key here where it used to
# need only the LLM provider one. In docker it is a file secret mounted only into the worker,
# and the FILE must exist even when blank: compose refuses to start a container whose secret
# file is missing.
# BRAVE_KEY=

# The search endpoint. The client reads the `discussions` block beside `web`: measured
# 2026-08-12, 229 of 440 stored sources came from discussions.
# BRAVE_SEARCH_URL=https://api.search.brave.com/res/v1/web/search

# Web results requested per query; 10 is what the top-ten judge input needs.
# BRAVE_RESULT_COUNT=10

# Merged results fetched and shown to the judge per package. Each one costs a page fetch.
# CORROBORATION_SOURCES_PER_PACKAGE=10

# Queries ONE corroboration job may spend. The rate headers read 50 requests per SECOND with
# an unverifiable monthly component, so this is a job-level ceiling set against whatever plan
# the operator actually holds.
# CORROBORATION_MAX_QUERIES_PER_JOB=500

# Searches in flight at once, the same concurrency-bound shape as the LLM client.
# BRAVE_MAX_CONCURRENCY=8

# How long a package's cached search rows stand before it re-searches.
# CORROBORATION_SEARCH_TTL_DAYS=30.0

# How many packages one corroboration job may judge; a job's params may lower it, never raise.
# CORROBORATION_MAX_PACKAGES=500

# Billed judge requests ONE package may cost, counting every wire retry.
# CORROBORATION_MAX_CALLS_PER_PACKAGE=3

# Read/connect deadlines for one search call and one page fetch. Short on purpose: a slow
# source becomes a retried-later row, not a stalled job.
# BRAVE_REQUEST_TIMEOUT_SECONDS=15.0
# PAGE_FETCH_TIMEOUT_SECONDS=10.0
# PAGE_FETCH_DEADLINE_SECONDS=30.0

# Page-fetch ceilings: the head of a long page is still evidence.
# PAGE_FETCH_MAX_BYTES=4194304
# PAGE_TEXT_MAX_CHARS=4000

# docker-compose.yml only (not read by the app itself): pin the web port to a specific
# LAN interface instead of all interfaces. Unset keeps the default (0.0.0.0).
# WEB_BIND_ADDR=192.168.1.10

# docker-compose.yml only (not read by the app itself): the HOST directory bind-mounted as the
# worker's /scratch. It holds one firmware job at a time and a Samsung build is 11-19 GB
# before it is opened, so it wants a real disk rather than the one docker's volume driver
# lives on. Whatever it points at must be writable by the container user, which a bind mount
# does NOT arrange for you (and docker creates a missing one owned by root):
#   sudo mkdir -p /mnt/ssd-1/scratch && sudo chown 65532:65532 /mnt/ssd-1/scratch
# WORKER_SCRATCH_DIR=/mnt/ssd-1/scratch
